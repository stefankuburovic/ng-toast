{
  "name": "ng-toast-workspace",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build ng-toast && node scripts/strip-tslib.mjs",
    "test": "ng test --watch=false",
    "demo": "ng serve demo",
    "demo:build": "ng build demo --base-href /ng-toast/",
    "pack": "npm run build && cd dist/ng-toast && npm pack",
    "release": "npm test && npm run build && cd dist/ng-toast && npm publish --access public"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.0.8",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
