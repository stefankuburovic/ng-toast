    "angular",
    "toast",
    "toastr",
    "notification",
    "zoneless",
    "signals"
  ],
  "license": "MIT",
  "author": "Stefan Kuburovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefankuburovic/ng-toast.git"
  },
  "homepage": "https://github.com/stefankuburovic/ng-toast#readme",
  "bugs": {
    "url": "https://github.com/stefankuburovic/ng-toast/issues"
  },
  "peerDependencies": {
    "@angular/core": ">=20.2.0",
    "rxjs": "^7.4.0"
  },
  "exports": {
    "./toast.css": {
      "style": "./toast.css",
      "default": "./toast.css"
    },
    "./toast-material.css": {
      "style": "./toast-material.css",
      "default": "./toast-material.css"
    }
  },
  "sideEffects": [
    "*.css"
  ]
